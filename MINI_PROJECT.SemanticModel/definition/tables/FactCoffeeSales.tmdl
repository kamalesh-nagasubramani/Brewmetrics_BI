table FactCoffeeSales
	lineageTag: a2722342-865b-4791-afaa-40e2173c7b23

	measure 'Total Sales' =
			
			SUM(FactCoffeeSales[sales_amount])
		lineageTag: 60e36676-6237-41f8-9fae-641cb8777ce4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Month Sales' =
			
			CALCULATE(
			    [Total Sales],
			    DATEADD(DimDate[date], -1, MONTH)
			)
		lineageTag: c111b6ec-e08c-4456-bbc8-eb72f1a8ed0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Month-over-Month Sales Growth %' =
			
			DIVIDE(
			    [Total Sales] - [Previous Month Sales],
			    [Previous Month Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 59aa74a6-be33-4e14-8220-a5bba999e6af

	measure 'Cumulative Sales' =
			
			CALCULATE(
			    [Total Sales],
			    FILTER(
			        ALLSELECTED(DimDate[date]),
			        DimDate[date] <= MAX(DimDate[date])
			    )
			)
		lineageTag: 4ac81bf7-ab91-4f79-847d-a6724a1da67f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column sale_id
		dataType: int64
		formatString: 0
		lineageTag: 19683aa8-7689-43f9-ba92-6f32570ee396
		summarizeBy: sum
		sourceColumn: sale_id

		annotation SummarizationSetBy = Automatic

	column date
		dataType: dateTime
		formatString: Long Date
		lineageTag: a7fd27e5-8b3c-4b12-9186-5ae9bfd02f93
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column city
