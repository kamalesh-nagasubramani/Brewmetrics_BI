		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column StoreKey =
			
			LOOKUPVALUE(
			    DimStore[Storekey],
			    DimStore[city], FactCoffeeSales[city],
			    DimStore[store_format], FactCoffeeSales[store_format]
			)
		formatString: 0
		lineageTag: ef43891b-6996-4a46-86ba-24e9d55b26a5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

